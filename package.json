{
  "name": "capacitor-game-services",
  "version": "0.1.0",
  "description": "Apple Game Center and Google Play Games for Capacitor games: silent sign-in, server proof, leaderboards and achievements, plus a server helper to check who the player is.",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources",
    "Package.swift",
    "CapacitorGameServices.podspec"
  ],
  "author": "DZK Consulting",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DZK-Consulting/capacitor-game-services.git"
  },
  "bugs": {
    "url": "https://github.com/DZK-Consulting/capacitor-game-services/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "game-center",
    "gamekit",
    "play-games",
    "leaderboards",
    "achievements"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "xcodebuild -scheme CapacitorGameServices -destination generic/platform=iOS",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build && npm test",
    "lint": "npm run eslint && npm run prettier -- --check",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "docgen": "docgen --api GameServicesPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "check:dist": "npm run build && git diff --exit-code -- dist"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.0.0",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "eslint": "^8.57.1",
    "prettier": "^3.6.2",
    "prettier-plugin-java": "^2.7.7",
    "rimraf": "^6.1.0",
    "rollup": "^4.53.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "@types/node": "^22.19.0"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/plugin.cjs.js"
    },
    "./server": {
      "types": "./dist/esm/server/index.d.ts",
      "import": "./dist/esm/server/index.js"
    },
    "./package.json": "./package.json"
  }
}
